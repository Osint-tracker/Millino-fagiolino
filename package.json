{
  "name": "mirees-study-os",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "android:sync": "npm run build && cap sync android",
